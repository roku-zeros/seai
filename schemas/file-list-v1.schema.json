{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/file-list-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "index_generation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "historical_or_explicit": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "source-v1.schema.json#/properties/files/items"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "next_offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "source_snapshot_id",
    "historical_or_explicit",
    "files",
    "truncated",
    "next_offset"
  ]
}
