{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/research-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "required": [
    "objective",
    "topics"
  ]
}
