{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/job-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "ABORTED"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index_generation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage": {
          "const": "partial"
        }
      },
      "required": [
        "source_snapshot_id",
        "index_generation_id",
        "coverage"
      ]
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "state"
  ]
}
