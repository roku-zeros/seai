{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/rpc-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "handshake",
        "capabilities.get",
        "project.get",
        "index.build",
        "jobs.get",
        "search.entities",
        "workspace.status",
        "files.list",
        "file.read",
        "symbol.get",
        "references.find",
        "calls.list",
        "tests.related",
        "search.text",
        "task.create",
        "task.get",
        "task.plan",
        "task.revise",
        "task.cancel",
        "task.resume",
        "patch.apply",
        "task.diff",
        "task.export",
        "checks.profiles",
        "checks.run",
        "task.verify",
        "runs.get",
        "runs.logs",
        "runs.cancel",
        "provider.status",
        "provider.probe",
        "task.run",
        "agents.list",
        "release.plan",
        "release.inspect",
        "release.apply",
        "release.rollback",
        "task.rebase",
        "backup.create",
        "runs.artifact"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "seai.api/v1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_project_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "ref": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "cursor": {
          "type": "string"
        },
        "index_generation_id": {
          "type": "string"
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "symbol_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "$ref": "change-v1.schema.json"
        },
        "plan": {
          "$ref": "plan-v1.schema.json"
        },
        "patch": {
          "$ref": "patch-v1.schema.json"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "behavior_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "allow_incomplete": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "resume_from": {
          "type": "string"
        },
        "release_id": {
          "type": "string"
        },
        "overlay_policy": {
          "type": "string"
        },
        "resolution": {
          "$ref": "patch-v1.schema.json"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "index.build"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "jobs.get"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "job_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "search.entities"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "query"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.create"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "spec"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.plan"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id",
              "plan"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.revise"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id",
              "spec"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.cancel"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.resume"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "patch.apply"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id",
              "patch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "task.export"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch",
              "expected_revision",
              "task_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "search.text"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "query"
            ]
          }
        }
      }
    }
  ]
}
