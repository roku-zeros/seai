{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/rpc-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "handshake",
        "capabilities.get",
        "project.get",
        "index.build",
        "jobs.get",
        "search.entities"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "seai.api/v1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_project_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "ref": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      },
      "required": [
        "schema_version"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "index.build"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "operation_id",
              "expected_project_epoch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "jobs.get"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "job_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "search.entities"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "query"
            ]
          }
        }
      }
    }
  ]
}
