{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seai.local/schemas/change-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "seai.change/v1"
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "explain",
        "change",
        "refactor"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "source_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "content_digest": {
            "type": "string",
            "pattern": "^(sha256:)?[a-f0-9]{64}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "required": [
          "external_id",
          "revision",
          "content_digest",
          "content"
        ]
      },
      "maxItems": 32
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 200
        }
      },
      "required": [
        "files"
      ]
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement"
        ]
      },
      "maxItems": 200
    },
    "preserved_behavior": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement"
        ]
      },
      "maxItems": 200
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "behavior_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 200
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "assertion_profile": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "behavior_ids",
          "expected",
          "assertion_profile"
        ]
      },
      "maxItems": 200
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "revision",
    "kind",
    "objective",
    "source_requirements",
    "scope",
    "expected_behavior",
    "preserved_behavior",
    "acceptance_criteria",
    "unresolved"
  ]
}
